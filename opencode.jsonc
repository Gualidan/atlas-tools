{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "obsidian": {
        "type": "remote",
        "url": "http://127.0.0.1:27123/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/obsidian-mcp-token}"
        }
      }
    }
  }
}
